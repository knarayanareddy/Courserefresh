# Courserefresh — copy to .env (gitignored) and fill in what you have.
# Nothing here is required for the offline twin or the battery: `sh app/check.sh` runs with no keys.

# --- runtime -------------------------------------------------------------------------------------
# auto = live only when Apify + a judge key are both present; force with `live` or `sim`.
CR_MODE=auto
CR_LIVE_SCAN_MINUTES=60
CR_BOT_BRANCH=bot/courserefresh
CR_COMMIT=0                     # 1 = commit artifacts on CR_BOT_BRANCH (the engine never switches branches)
CR_DEMO_TOKEN=                  # set to require a token for --resume and console writes
CR_CONSOLE_PORT=8080
CR_CONSOLE_TOKEN=               # set to gate POST /pause and /resume
CR_TELEMETRY_PORT=8787
CR_TELEMETRY_TOKEN=             # shared secret for learner clients posting /telemetry

# --- Apify (criterion 3: real-world data) ---------------------------------------------------------
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_MAX_RETRIES=1
APIFY_TIMEOUT_S=300

# --- Judge / models (the key your provider gave you — any OpenAI-compatible endpoint) --------------
# mock = recorded answers from app/fixtures/judge/*.json (offline, labelled); openai|anthropic|n8n = live.
CR_JUDGE_PROVIDER=mock
CR_JUDGE_BASE_URL=https://api.openai.com/v1
CR_JUDGE_API_KEY=
CR_JUDGE_MODEL=gpt-4o-mini
CR_OBSERVE_MODEL=gpt-4o-mini
CR_JUDGE_TIMEOUT_S=60
# jev = TypeSafe "System One" typed decisions (POST /v1/systemone). Its own trio: a provider never
# inherits another provider's credentials. No key => the loop stays sim and says so, loudly.
CR_JEV_BASE_URL=https://api.typesafe.ai
CR_JEV_API_KEY=
CR_JEV_MODEL=jev-latest

# --- Tavily (the second discovery source, beside Apify; 30 credits/day in skin/thresholds.json) ---
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# --- n8n (criterion 3: the canvas runs the workflows and the decisions) ---------------------------
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_URL=                # optional: set when the judge call should run through n8n
N8N_INSTANCE_VERSION=           # recorded in WIRING.md §4 before the hero run

# --- Learner channel (delivery) -------------------------------------------------------------------
# file = stage only (honest default); telegram | webhook = deliver.
CR_NOTIFY_CHANNEL=file
CR_TELEGRAM_BOT_TOKEN=
CR_TELEGRAM_CHAT_ID=
CR_NOTIFY_WEBHOOK_URL=
